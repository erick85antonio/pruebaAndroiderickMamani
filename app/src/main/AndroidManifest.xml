<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.container2">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="FitTracker"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <!-- 1. Pantalla de Bienvenida (RecyclerActivity) - Rúbrica Punto 1 -->
        <activity
            android:name="com.example.container2.RecyclerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Formulario Principal de Registro (MainActivity) - Rúbrica Puntos 2 y 3 -->
        <activity
            android:name="com.example.container2.MainActivity"
            android:exported="false" />

        <!-- 3. Otras Actividades del Proyecto Base -->
        <activity
            android:name="com.example.container2.SpinnerActivity"
            android:exported="false" />

    </application>

</manifest>